@model P3AddNewFunctionalityDotNetCore.Models.ViewModels.ProductViewModel
@{
    ViewData["Title"] = Localizer["CreatProductTitle"];
    Layout = "_AdminLayout";
}

<div class="container d-flex ">
    <div class="col-4">
        <form asp-action="Create" method="post">

            <div class="mb-3 col-12">
                <label>@Localizer["Name"]*:</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3 col-12">
                <label>@Localizer["Price"]*:</label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="mb-3 col-12">
                <label>@Localizer["Description"]:</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3 col-12">
                <label>@Localizer["Stock"]*:</label>
                <input asp-for="Stock" type="text" class="form-control" />
                <span asp-validation-for="Stock" class="text-danger"></span>
            </div>

            <div class="mb-3 col-12">
                <label>@Localizer["Details"]:</label>
                <input asp-for="Details" class="form-control" />
                <span asp-validation-for="Details" class="text-danger"></span>
            </div>

            <div class="text-end">
                <input class="btn btn-primary" type="submit" value="@Localizer["OK"]" />
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
